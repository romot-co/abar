{
  "name": "abar-ui",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "js-yaml": "4.3.0"
  },
  "scripts": {
    "build": "npm run generate:api && tsc -b && vite build",
    "dev": "vite",
    "generate:api": "uv run --project .. python ../scripts/export_openapi.py openapi.json && openapi-ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "6.0.3",
    "vite": "8.2.0"
  }
}
